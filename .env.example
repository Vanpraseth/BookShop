# Copy this file to .env for reference, then keep the real .env private.
APP_ENV=production
SECRET_KEY=
PORT=8080
BOOKSHOP_DB=/app/data/bookshop.db
SEED_CATALOGUE=true
TOKEN_MAX_AGE=86400
MAX_CONTENT_LENGTH_BYTES=1048576
APP_NAME=BookShop
CURRENCY_CODE=AUD
DEFAULT_SHIPPING_ETA=3-5 business days
TRACKING_PREFIX=TRK
NOTIFICATION_POLL_SECONDS=30

# Only needed when the frontend is hosted on a different origin.
CORS_ORIGINS=

# Optional: creates the first administrator when the database is empty.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Enable only when the hosting platform uses a trusted reverse proxy.
TRUST_PROXY=false
